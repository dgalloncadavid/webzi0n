      "text": "{color.mist}",
      "text-rgb": "{rgb.mist}",
      "text-2": "{color.ice}",
      "text-soft": "rgba({rgb.mist},.62)",
      "muted": "{color.muted}",
      "eyebrow": "{color.ice}",
      "placeholder": "rgba({rgb.ice},.45)",
      "line": "rgba({rgb.ice},.16)",
      "border": "rgba({rgb.ice},.28)",
      "border-ghost": "rgba({rgb.ice},.32)",
      "icon-border": "rgba({rgb.ice},.3)",
      "divider": "rgba({rgb.ice},.16)",
      "divider-graphene": "rgba({rgb.ice},.18)",
      "focus": "{color.signal}",
      "focus-shadow": "0 0 0 3px rgba({rgb.signal},.18)",
      "hover": "rgba({rgb.white},.04)",
      "hover-border": "{color.ice}",
      "hover-text": "{color.white}",
      "active": "rgba({rgb.signal},.08)",
      "active-border": "{color.signal}",
      "good-border": "rgba({rgb.signal},.6)",
      "disabled": "rgba({rgb.ice},.14)",
      "disabled-text": "rgba({rgb.mist},.45)",
